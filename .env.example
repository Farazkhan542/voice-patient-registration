# --- Backend ---------------------------------------------------------------
# SQLite by default. On Railway, add a Postgres service and reference its DATABASE_URL.
DATABASE_URL=sqlite:///./data/patients.db
# Insert two demo patients when the table is empty.
SEED_DATA=true

# --- LLM (OpenAI Agents SDK on an OpenAI-compatible endpoint) --------------
# Set ONE of these. OpenRouter is used if both are set.
# OpenRouter key: https://openrouter.ai/keys  (default model google/gemini-2.5-flash)
OPENROUTER_API_KEY=
# Gemini key: https://aistudio.google.com/apikey  (default model gemini-3.5-flash-lite)
GEMINI_API_KEY=
# Optional overrides. Fallbacks are tried in order when a model is rate-limited or failing.
# LLM_MODEL=
# LLM_FALLBACK_MODELS=model-a,model-b
# LLM_BASE_URL=

# --- Vapi (telephony + speech) ---------------------------------------------
# Private API key from https://dashboard.vapi.ai -> API Keys. Only used by scripts/setup_vapi.py.
VAPI_API_KEY=
# Public HTTPS URL of this backend (Railway URL or ngrok URL), no trailing slash.
PUBLIC_BASE_URL=
# Required. Any long random string; Vapi must present it on every request to this backend.
# Use letters and digits only (it is part of a URL path).
VAPI_WEBHOOK_SECRET=
# Set after the first run of setup_vapi.py so later runs update instead of creating a new assistant.
VAPI_ASSISTANT_ID=
# Optional: which Vapi phone number to attach. Defaults to the first number on the account.
VAPI_PHONE_NUMBER_ID=
# Optional voice override (leave blank for Vapi's default voice).
VAPI_VOICE_PROVIDER=
VAPI_VOICE_ID=
